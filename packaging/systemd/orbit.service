[Unit]
Description=Orbit File Synchronization Engine
Documentation=https://github.com/calebhabesh/orbit
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/orbit serve --state=%h/.local/state/orbit --control-listen=127.0.0.1:8080
ExecStop=/usr/bin/orbit stop --state=%h/.local/state/orbit
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s

# Environment & resource bounds (Operations baseline)
LimitNOFILE=65536
MemoryHigh=512M
MemoryMax=1G

# Unix ownership protects system directories. Filesystem namespace sandboxing
# can force Ubuntu's unprivileged_userns AppArmor profile, which rejects
# descriptor-rooted access. Preserve host AppArmor/VPN/firewall policy.
NoNewPrivileges=yes

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=orbit

[Install]
WantedBy=default.target
